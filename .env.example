# Fabi Nails — variáveis de ambiente
# Copie este arquivo para .env.local em desenvolvimento.
# Na Vercel: Dashboard > seu projeto > Settings > Environment Variables > Add
# Defina cada variável para Production + Preview + Development.
# NÃO commitar valores reais — apenas placeholders aqui.
#
# O que é Prisma/SQL (explicação simples):
# Prisma é o "tradutor" entre seu código TypeScript e o banco de dados.
# Você escreve prisma.service.findMany() e ele gera SQL por baixo.
# Não precisa escrever SQL manual — só preencher DATABASE_URL.

# 1) Banco de dados — PostgreSQL (Neon)
# Onde pegar: Neon Dashboard > seu projeto > Connect > connection string (pooled)
# Formato: postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# 2) NextAuth — autenticação do /admin
# NEXTAUTH_SECRET: gere um segredo aleatório com:
#   openssl rand -base64 32
# NEXTAUTH_URL: URL pública do site
#   local: http://localhost:3000
#   produção: https://SEU-PROJETO.vercel.app (trocar pelo domínio real da Vercel)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# 3) Acesso admin (/admin/login)
# ADMIN_USER: nome de usuário para login
# ADMIN_PASSWORD_HASH: hash bcrypt da senha (nunca a senha em texto)
# Gere com (substitua SUA_SENHA_AQUI):
#   node -e "require('bcryptjs').hash('SUA_SENHA_AQUI',12).then(console.log)"
ADMIN_USER=""
ADMIN_PASSWORD_HASH=""

# 4) Opcional — WhatsApp exibido no site (sem + e sem espaços)
FABI_WHATSAPP="5543996524776"
